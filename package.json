{
  "name": "sistema-pedidos-app",
  "version": "1.0.0",
  "description": "Sistema de gerenciamento de pedidos com banco SQLite",
  "main": "electron-main.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings server.js",
    "app": "electron .",
    "build:exe": "electron-builder --win --x64",
    "build:zip": "electron-builder --win --x64 --config.win.target=zip",
    "check": "node --check server.js && node --check script.js && node --check electron-main.js && node --check preload.js && node --check service-worker.js"
  },
  "private": true,
  "build": {
    "appId": "br.local.sistema-pedidos",
    "productName": "Sistema de Pedidos",
    "executableName": "app",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "artifactName": "app.${ext}",
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "index.html",
      "style.css",
      "script.js",
      "service-worker.js",
      "manifest.json",
      "logoJECS.png",
      "data/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "logoJECS.png",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1"
  }
}
